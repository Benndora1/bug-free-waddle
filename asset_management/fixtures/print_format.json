  "html": "<div style=\"font-family: Arial, sans-serif; font-size: 13px; color: #1a1a1a; padding: 25px;\">\n    <div style=\"border-bottom: 3px solid #003366; padding-bottom: 12px; margin-bottom: 20px;\">\n        <table style=\"width: 100%;\">\n            <tr>\n                <td>\n                    <h2 style=\"color: #003366; margin: 0; font-size: 22px;\">{{ doc.company or \"INSTITUTIONAL ASSET MANAGEMENT\" }}</h2>\n                    <p style=\"margin: 3px 0; color: #555; font-size: 12px;\">Institutional Asset Management | Statement of Portfolio Valuation</p>\n                </td>\n                <td style=\"text-align: right;\">\n                    <span style=\"font-size: 11px; color: #555;\">Statement Date:</span><br>\n                    <strong style=\"font-size: 14px; color: #003366;\">{{ frappe.utils.nowdate() }}</strong>\n                </td>\n            </tr>\n        </table>\n    </div>\n\n    <table style=\"width: 100%; margin-bottom: 20px; background: #f8fafc; padding: 15px; border-radius: 4px; border: 1px solid #e2e8f0;\">\n        <tr>\n            <td style=\"width: 50%;\">\n                <span style=\"color: #64748b; font-size: 11px;\">INVESTOR NAME</span><br>\n                <strong style=\"font-size: 15px; color: #0f172a;\">{{ doc.investor_name }}</strong><br>\n                <span style=\"font-size: 12px; color: #475569;\">ID: {{ doc.investor }}</span>\n            </td>\n            <td style=\"width: 50%;\">\n                <span style=\"color: #64748b; font-size: 11px;\">SCHEME / FUND</span><br>\n                <strong style=\"font-size: 15px; color: #0f172a;\">{{ doc.fund_name }}</strong><br>\n                <span style=\"font-size: 12px; color: #475569;\">Currency: {{ doc.currency }}</span>\n            </td>\n        </tr>\n    </table>\n\n    <div style=\"display: flex; gap: 10px; margin-bottom: 25px;\">\n        <table style=\"width: 100%; border: 1px solid #e2e8f0; border-collapse: collapse; text-align: center;\">\n            <tr style=\"background: #003366; color: white;\">\n                <th style=\"padding: 10px;\">Units Held</th>\n                <th style=\"padding: 10px;\">Current NAV / Unit</th>\n                <th style=\"padding: 10px;\">Market Valuation ({{ doc.currency }})</th>\n                <th style=\"padding: 10px;\">Net Capital Invested</th>\n                <th style=\"padding: 10px;\">Unrealized Gain / Loss</th>\n            </tr>\n            <tr style=\"font-size: 14px; font-weight: bold; background: #ffffff;\">\n                <td style=\"padding: 12px; color: #003366;\">{{ \"{:,.4f}\".format(doc.total_units) }}</td>\n                <td style=\"padding: 12px;\">{{ \"{:,.4f}\".format(doc.current_nav_per_unit) }}</td>\n                <td style=\"padding: 12px; color: #003366;\">{{ \"{:,.2f}\".format(doc.current_market_value) }}</td>\n                <td style=\"padding: 12px;\">{{ \"{:,.2f}\".format(doc.total_invested_amount - doc.total_withdrawn_amount) }}</td>\n                <td style=\"padding: 12px; color: {% if doc.unrealized_gain_loss >= 0 %}#16a34a{% else %}#dc2626{% endif %};\">\n                    {{ \"{:,.2f}\".format(doc.unrealized_gain_loss) }}\n                </td>\n            </tr>\n        </table>\n    </div>\n\n    <h4 style=\"color: #003366; border-bottom: 2px solid #003366; padding-bottom: 6px; margin-bottom: 10px;\">Registered Settlement Account</h4>\n    <p style=\"font-size: 12px; margin: 0 0 20px 0;\">\n        Bank: <strong>{{ doc.bank_name or 'Settlement Bank' }}</strong> | Branch: <strong>{{ doc.bank_branch or 'Main' }}</strong> | Account No: <strong>{{ doc.bank_account_no or 'N/A' }}</strong> | Name: <strong>{{ doc.bank_account_name or doc.investor_name }}</strong>\n    </p>\n\n    <div style=\"font-size: 10px; color: #64748b; border-top: 1px solid #e2e8f0; padding-top: 10px; text-align: center;\">\n        This statement is issued for valuation and information purposes. For inquiries, please email support@assetmanagement.cloud.\n    </div>\n</div>",
