  "font": null,
  "font_size": 14,
  "format_data": null,
  "html": "<div style=\"font-family: Arial, sans-serif; font-size: 13px; color: #1a1a1a; padding: 25px;\">\n    <div style=\"border-bottom: 3px solid #003366; padding-bottom: 12px; margin-bottom: 20px;\">\n        <table style=\"width: 100%;\">\n            <tr>\n                <td style=\"width: 65%;\">\n                    <h2 style=\"color: #003366; margin: 0; font-size: 22px; text-transform: uppercase;\">{{ doc.company or \"Institutional Asset Management\" }}</h2>\n                    <p style=\"margin: 3px 0; color: #555; font-size: 12px;\">Licensed Collective Investment Scheme Manager & Fund Administrator</p>\n                    <p style=\"margin: 3px 0; color: #555; font-size: 12px;\">Financial Center, Institutional Asset Operations</p>\n                </td>\n                <td style=\"width: 35%; text-align: right;\">\n                    <div style=\"background-color: #f0f4f8; padding: 10px; border-radius: 4px; border: 1px solid #d0dbe5;\">\n                        <span style=\"font-size: 11px; color: #555; text-transform: uppercase;\">Contract Note No:</span><br>\n                        <strong style=\"font-size: 15px; color: #003366;\">{{ doc.contract_note_no or doc.name }}</strong><br>\n                        <span style=\"font-size: 11px; color: #555;\">Date: <strong>{{ doc.subscription_date }}</strong></span>\n                    </div>\n                </td>\n            </tr>\n        </table>\n    </div>\n\n    <div style=\"text-align: center; margin-bottom: 25px;\">\n        <h3 style=\"margin: 0; color: #003366; letter-spacing: 1px; font-size: 16px; text-transform: uppercase; border-bottom: 1px solid #ddd; padding-bottom: 8px;\">\n            Unit Trust Subscription Contract Note\n        </h3>\n    </div>\n\n    <table style=\"width: 100%; margin-bottom: 25px;\">\n        <tr>\n            <td style=\"width: 48%; vertical-align: top; background: #fafafa; padding: 12px; border: 1px solid #eee; border-radius: 4px;\">\n                <h4 style=\"margin: 0 0 10px 0; color: #003366; border-bottom: 1px solid #ccc; padding-bottom: 4px;\">Investor Details</h4>\n                <table style=\"width: 100%; font-size: 12px;\">\n                    <tr><td style=\"color: #666; width: 40%;\">Account ID:</td><td><strong>{{ doc.investor }}</strong></td></tr>\n                    <tr><td style=\"color: #666;\">Investor Name:</td><td><strong>{{ doc.investor_name }}</strong></td></tr>\n                    <tr><td style=\"color: #666;\">Payment Method:</td><td>{{ doc.payment_method }}</td></tr>\n                    <tr><td style=\"color: #666;\">Bank Reference:</td><td>{{ doc.bank_reference or 'N/A' }}</td></tr>\n                </table>\n            </td>\n            <td style=\"width: 4%;\"></td>\n            <td style=\"width: 48%; vertical-align: top; background: #fafafa; padding: 12px; border: 1px solid #eee; border-radius: 4px;\">\n                <h4 style=\"margin: 0 0 10px 0; color: #003366; border-bottom: 1px solid #ccc; padding-bottom: 4px;\">Collective Investment Scheme</h4>\n                <table style=\"width: 100%; font-size: 12px;\">\n                    <tr><td style=\"color: #666; width: 40%;\">Fund Code:</td><td><strong>{{ doc.fund }}</strong></td></tr>\n                    <tr><td style=\"color: #666;\">Fund Name:</td><td><strong>{{ doc.fund_name }}</strong></td></tr>\n                    <tr><td style=\"color: #666;\">Currency:</td><td>{{ doc.currency }}</td></tr>\n                    <tr><td style=\"color: #666;\">Value Date:</td><td>{{ doc.value_date }}</td></tr>\n                </table>\n            </td>\n        </tr>\n    </table>\n\n    <table style=\"width: 100%; border-collapse: collapse; margin-bottom: 30px;\">\n        <thead>\n            <tr style=\"background-color: #003366; color: white;\">\n                <th style=\"padding: 10px; text-align: left;\">Transaction Description</th>\n                <th style=\"padding: 10px; text-align: right;\">Unit Offer Price</th>\n                <th style=\"padding: 10px; text-align: right;\">Units Allocated</th>\n                <th style=\"padding: 10px; text-align: right;\">Gross Investment ({{ doc.currency }})</th>\n            </tr>\n        </thead>\n        <tbody>\n            <tr style=\"border-bottom: 1px solid #eee;\">\n                <td style=\"padding: 10px;\">Subscription to {{ doc.fund_name }}</td>\n                <td style=\"padding: 10px; text-align: right;\">{{ \"{:,.4f}\".format(doc.applicable_nav_price) }}</td>\n                <td style=\"padding: 10px; text-align: right;\"><strong>{{ \"{:,.4f}\".format(doc.units_allocated) }}</strong></td>\n                <td style=\"padding: 10px; text-align: right;\">{{ \"{:,.2f}\".format(doc.gross_amount) }}</td>\n            </tr>\n            {% if doc.entry_fee_amount and doc.entry_fee_amount > 0 %}\n            <tr style=\"border-bottom: 1px solid #eee; color: #888;\">\n                <td style=\"padding: 10px;\" colspan=\"3\">Less Entry Fee ({{ doc.entry_fee_pct }}%)</td>\n                <td style=\"padding: 10px; text-align: right;\">-{{ \"{:,.2f}\".format(doc.entry_fee_amount) }}</td>\n            </tr>\n            {% endif %}\n            <tr style=\"background-color: #f5f8fa; font-weight: bold; border-top: 2px solid #003366;\">\n                <td style=\"padding: 10px;\" colspan=\"2\">Net Capital Invested:</td>\n                <td style=\"padding: 10px; text-align: right; color: #003366;\">{{ \"{:,.4f}\".format(doc.units_allocated) }} Units</td>\n                <td style=\"padding: 10px; text-align: right; color: #003366;\">{{ \"{:,.2f}\".format(doc.net_invested_amount) }} {{ doc.currency }}</td>\n            </tr>\n        </tbody>\n    </table>\n\n    <div style=\"margin-top: 40px; border-top: 1px solid #ddd; padding-top: 20px;\">\n        <table style=\"width: 100%;\">\n            <tr>\n                <td style=\"width: 45%; text-align: center;\">\n                    <div style=\"border-bottom: 1px dashed #666; width: 80%; margin: 0 auto 5px auto; height: 30px;\"></div>\n                    <span style=\"font-size: 11px; color: #555;\">Authorized Signatory - Operations</span><br>\n                    <strong style=\"font-size: 12px;\">{{ doc.company or \"Institutional Asset Management\" }}</strong>\n                </td>\n                <td style=\"width: 10%;\"></td>\n                <td style=\"width: 45%; text-align: center;\">\n                    <div style=\"border-bottom: 1px dashed #666; width: 80%; margin: 0 auto 5px auto; height: 30px;\"></div>\n                    <span style=\"font-size: 11px; color: #555;\">Fund Custodian & Trustee</span><br>\n                    <strong style=\"font-size: 12px;\">Fund Custodian & Trustee Bank</strong>\n                </td>\n            </tr>\n        </table>\n    </div>\n\n    <div style=\"margin-top: 30px; font-size: 10px; color: #777; border-top: 1px solid #eee; padding-top: 10px; text-align: center;\">\n        Regulated by the Financial Markets & Regulatory Authority under the Collective Investment Schemes Act. Unit values fluctuate with market changes.\n    </div>\n</div>",
