  "html": "<div style=\"font-family: Arial, sans-serif; font-size: 12px; color: #111; padding: 25px; line-height: 1.5;\">\n    <div style=\"margin-bottom: 15px;\">\n        <p style=\"margin: 0; font-weight: bold;\">{{ frappe.utils.format_date(doc.instruction_date, \"EEEE, MMMM d, yyyy\") }}.</p>\n        <p style=\"margin: 5px 0 0 0;\">\n            <strong>{{ doc.custodian_bank or \"Institutional Custodian Bank Limited\" }},</strong><br>\n            Corporate & Investment Banking,<br>\n            Global Custody & Securities Settlement Division.<br>\n            <strong>Attention: Head, Investor Services (TPS)</strong>\n        </p>\n    </div>\n\n    <p style=\"font-size: 14px; font-weight: bold; margin: 15px 0 10px 0; text-transform: uppercase; color: #003366;\">\n        RE: {{ doc.transaction_type }}:\n    </p>\n    <p style=\"margin: 0 0 15px 0;\">Please action the transactions as per details indicated below:</p>\n\n    <div style=\"margin-bottom: 15px;\">\n        <strong>Counterparty:</strong> {{ doc.counterparty }}\n    </div>\n\n    <table style=\"width: 100%; border-collapse: collapse; margin-bottom: 25px; font-size: 11px;\">\n        <tr style=\"background-color: #f2f2f2; font-weight: bold; border-bottom: 1px solid #333; border-top: 1px solid #333;\">\n            <td style=\"padding: 6px;\">Fund Account</td>\n            <td style=\"padding: 6px;\">Security Description</td>\n            <td style=\"padding: 6px; text-align: center;\">Maturity</td>\n            <td style=\"padding: 6px; text-align: right;\">Coupon</td>\n            <td style=\"padding: 6px; text-align: right;\">Yield</td>\n            <td style=\"padding: 6px; text-align: right;\">Clean Price</td>\n            <td style=\"padding: 6px; text-align: right;\">Face Value (UGX)</td>\n            <td style=\"padding: 6px; text-align: right;\">Settlement Amount (UGX)</td>\n            <td style=\"padding: 6px; text-align: center;\">Settle Date</td>\n            <td style=\"padding: 6px; text-align: center;\">Custodian</td>\n        </tr>\n        <tr style=\"border-bottom: 1px solid #ddd;\">\n            <td style=\"padding: 8px;\"><strong>{{ doc.fund }}</strong></td>\n            <td style=\"padding: 8px;\">{{ doc.security_description }}</td>\n            <td style=\"padding: 8px; text-align: center;\">{{ doc.settlement_date }}</td>\n            <td style=\"padding: 8px; text-align: right;\">{{ \"{:.3f}%\".format(doc.coupon_rate or 0) }}</td>\n            <td style=\"padding: 8px; text-align: right;\">{{ \"{:.3f}%\".format(doc.yield_to_maturity or 0) }}</td>\n            <td style=\"padding: 8px; text-align: right;\">{{ \"{:.3f}\".format(doc.clean_price or 100) }}</td>\n            <td style=\"padding: 8px; text-align: right;\"><strong>{{ \"{:,.0f}\".format(doc.face_value) }}</strong></td>\n            <td style=\"padding: 8px; text-align: right;\"><strong>{{ \"{:,.0f}\".format(doc.settlement_amount) }}</strong></td>\n            <td style=\"padding: 8px; text-align: center;\">{{ doc.settlement_date }}</td>\n            <td style=\"padding: 8px; text-align: center;\">SBU</td>\n        </tr>\n    </table>\n\n    <p style=\"margin: 20px 0 35px 0;\">In case of further inquiries contact the undersigned.</p>\n\n    <table style=\"width: 100%; margin-top: 30px;\">\n        <tr>\n            <td style=\"width: 45%; vertical-align: bottom;\">\n                {% if doc.maker_signed %}\n                <span style=\"color: #003366; font-style: italic; font-weight: bold; font-size: 13px;\">[Digitally Signed by Operations]</span><br>\n                {% endif %}\n                <strong>{{ doc.maker_signatory }}</strong><br>\n                <span>Fund Operations / Administrator</span><br>\n                <span>{{ doc.company or \"Institutional Asset Management\" }}</span>\n            </td>\n            <td style=\"width: 10%;\"></td>\n            <td style=\"width: 45%; vertical-align: bottom;\">\n                {% if doc.checker_signed %}\n                <span style=\"color: #003366; font-style: italic; font-weight: bold; font-size: 13px;\">[Digitally Signed by Investment Manager]</span><br>\n                {% endif %}\n                <strong>{{ doc.checker_signatory }}</strong><br>\n                <span>Investment Manager</span><br>\n                <span>{{ doc.company or \"Institutional Asset Management\" }}</span>\n            </td>\n        </tr>\n    </table>\n</div>",
